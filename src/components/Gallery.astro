---
interface Item {
  year?: string;
  title: string;
  image: string;
  url?: string;
  description?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;

// Slug used as an anchor id so the map's "View gallery" link can deep-link to a
// specific project card. Must stay in sync with the `#fragment` in locations.json.
const slugify = (s: string) =>
  s
    .normalize('NFKD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
---

<ul class="gallery">
  {
    items.map((item) => (
      <li class="gallery__item" id={slugify(item.title)}>
        <a
          class="gallery__frame"
          href={item.url ?? '#'}
          {...(item.url ? { target: '_blank', rel: 'noopener' } : {})}
        >
          <img src={item.image} alt={item.title} loading="lazy" />
        </a>
        <div class="gallery__meta">
          {item.year && <div class="gallery__year">{item.year}</div>}
          <h3 class="gallery__title">
            {item.url ? (
              <a href={item.url} target="_blank" rel="noopener">
                {item.title}
              </a>
            ) : (
              item.title
            )}
          </h3>
          {item.description && <p class="gallery__desc">{item.description}</p>}
        </div>
      </li>
    ))
  }
</ul>
