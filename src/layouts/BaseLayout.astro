---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { siteMeta, orgNode, laurenceNode, ayseNode } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** schema.org type for this page's WebPage node (e.g. 'CollectionPage'). */
  pageType?: string;
  /** Extra JSON-LD graph nodes contributed by the page. */
  jsonLd?: Record<string, unknown>[];
}
const {
  title,
  description = 'Laurence Salzmann and Ayşe Gürsan-Salzmann Collection at the University of Pennsylvania Libraries.',
  pageType = 'WebPage',
  jsonLd = [],
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': '#website',
      name: siteMeta.name,
      description: siteMeta.description,
      url: Astro.site?.href,
      publisher: { '@id': '#org' },
      inLanguage: 'en',
    },
    orgNode,
    laurenceNode,
    ayseNode,
    {
      '@type': pageType,
      '@id': '#webpage',
      url: canonical,
      name: `${title} · ${siteMeta.name}`,
      description,
      isPartOf: { '@id': '#website' },
      publisher: { '@id': '#org' },
      inLanguage: 'en',
    },
    ...jsonLd,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Laurence Salzmann and Ayşe Gürsan-Salzmann Collection</title>
    {Astro.site && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
  </head>
  <body>
    <a class="skip" href="#content">Skip to main content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="wordmark" href="/">
          Laurence Salzmann &amp; Ayşe Gürsan-Salzmann Collection
          <small>Penn Libraries · Kislak Center</small>
        </a>
        <Nav />
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
