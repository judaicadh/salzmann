---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteMeta } from '../data/site';
import { heroImages, iiifSquare, itemUrl, cleanLabel } from '../data/hero';

const colenda =
  'https://digitalcollections.library.upenn.edu/items?f%5Bcollection_ssim%5D%5B%5D=Laurence+and+Ay%C5%9Fe+G%C3%BCrsan-Salzmann+Collection&per_page=50';

const jsonLd = [
  {
    '@type': 'Collection',
    '@id': '#collection',
    name: siteMeta.name,
    description: siteMeta.description,
    creator: [{ '@id': '#laurence' }, { '@id': '#ayse' }],
    publisher: { '@id': '#org' },
    url: colenda,
    genre: 'Documentary photography',
    isAccessibleForFree: true,
    image: heroImages.map((h) => iiifSquare(h.service, 1200)),
  },
];
---

<BaseLayout title="Home" pageType="CollectionPage" jsonLd={jsonLd}>
  <div class="container">
    <p class="eyebrow">University of Pennsylvania Libraries · Kislak Center</p>
    <h1 class="page-title home-title">
      Laurence Salzmann &amp; Ayşe Gürsan-Salzmann Collection
    </h1>

    <div class="hero-grid">
      {
        heroImages.map((h) => (
          <a href={itemUrl(h.itemId)} target="_blank" rel="noopener" title={cleanLabel(h.label)}>
            <img
              src={iiifSquare(h.service, 600)}
              srcset={`${iiifSquare(h.service, 300)} 300w, ${iiifSquare(h.service, 600)} 600w, ${iiifSquare(h.service, 900)} 900w`}
              sizes="(max-width: 560px) 50vw, (max-width: 1000px) 25vw, 180px"
              alt={`Laurence Salzmann — ${cleanLabel(h.label)}`}
              loading="lazy"
              width="600"
              height="600"
            />
          </a>
        ))
      }
    </div>

    <div class="prose home-intro">
      <p class="lead">
        Welcome to the University of Pennsylvania Libraries homepage for the
        <em>Laurence Salzmann and Ayşe Gürsan-Salzmann Collection</em>. Housed at the Libraries' Kislak
        Center for Special Collections, Rare Books and Manuscripts, the vast majority of the Salzmann
        collection may be viewed online via the Penn Libraries image repository,
        <a href={colenda} target="_blank" rel="noopener">Digital Collections</a>.
      </p>
      <p>
        The Laurence Salzmann collection at the Penn Libraries contains a significant portion of the
        photographic output from his long career documenting little known communities throughout the
        world. Researchers will find black and white and color photographs dating from 1967 to 2018, as
        well as other photographic, book, and film project documentation, such as book mock-ups,
        exhibition publicity and planning, and biographical sketches of subjects of photographs. Taken
        as a whole, this collection provides glimpses into a number of worlds not typically documented —
        immigrants, the poor, shepherds, and changing or vanishing communities. In addition, the
        viewpoint of the photographer, Laurence Salzmann, is evident, providing insight into the man
        behind the images.
      </p>

      <p class="map-cta">
        <a href="/map">Explore the collection's projects on the map →</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .home-title {
    max-width: 22ch;
  }
  .home-intro {
    margin-left: 0;
  }
  .map-cta {
    font-family: var(--display);
    font-size: 1.2rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
